doctype html
html
  head
    title Employees
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.bg-light
    .container.mt-4
      h2 Employee Master

      form(method="POST" action="/add-employee" class="row g-2 mb-3")
        .col-md-5
          input.form-control(type="text" name="name" placeholder="Employee Name" required)

        .col-md-4
          select.form-control(name="status")
            option(value="true") Active
            option(value="false") Inactive

        .col-md-3
          button.btn.btn-primary.w-100 Add Employee

      table#empTable.table.table-bordered
        thead.table-dark
          tr
            th No
            th Name
            th Status
            th Action

        tbody
          each emp, index in employees
            tr
              td= index + 1
              td= emp.name
              td
                if emp.status
                  span.badge.bg-success Active
                else
                  span.badge.bg-danger Inactive
              td
                a.btn.btn-danger.btn-sm(href=`/delete-employee/${emp.id}`) Delete

    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    script(src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js")
    script.
      new DataTable('#empTable');