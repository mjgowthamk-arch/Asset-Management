doctype html
html
  head
    title Asset Master
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.min.css")

  body.bg-light
    .container.mt-4
      h2 Asset Master

      .card.mb-4
        .card-body
          form(method="POST" action="/add-asset" class="row g-2")

            .col-md-2
              input.form-control(type="text" name="assetName" placeholder="Asset Name" required)

            .col-md-2
              input.form-control(type="text" name="serialNumber" placeholder="Serial Number" required)

            .col-md-2
              select.form-control(name="category" required)
                option(value="") Select Category
                option Laptop
                option Mobile Phone
                option Monitor
                option Printer
                option Tool

            .col-md-3
              input.form-control(type="text" name="model" placeholder="Model")

            .col-md-2
              input.form-control(type="number" name="value" placeholder="Value")

            .col-md-1.d-grid
              button.btn.btn-success Add

      .card
        .card-body
          table#assetTable.table.table-bordered.table-striped
            thead.table-dark
              tr
                th No
                th Asset Name
                th Serial Number
                th Category
                th Model
                th Value
                th Status
                th Action

            tbody
              each asset, index in assets
                tr
                  td= index + 1
                  td= asset.assetName
                  td= asset.serialNumber
                  td= asset.category
                  td= asset.model
                  td ₹#{asset.value}

                  td
                    if asset.status === "AVAILABLE"
                      span.badge.bg-success AVAILABLE
                    else if asset.status === "ISSUED"
                      span.badge.bg-warning ISSUED
                    else
                      span.badge.bg-danger SCRAPPED

                  td
                    a.btn.btn-warning.btn-sm(href=`/edit-asset/${asset.id}`) Update
                    a.btn.btn-danger.btn-sm(href=`/delete-asset/${asset.id}`) Delete

    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    script(src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js")
    script.
      new DataTable('#assetTable');