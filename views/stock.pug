doctype html
html
  head
    title Stock View
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.bg-light
    .container.mt-4

      h2 Stock View

      .card.mb-3
        .card-body.text-center
          h3.text-success Total Stock Value: ₹#{totalValue}

      table.table.table-bordered
        thead.table-dark
          tr
            th #
            th Asset Name
            th Serial Number
            th Model
            th Value

        tbody
          each asset, index in assets
            tr
              td= index + 1
              td= asset.assetName
              td= asset.serialNumber
              td= asset.model
              td ₹#{asset.value}