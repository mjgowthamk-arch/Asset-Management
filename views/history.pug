doctype html
html
  head
    title Asset History

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    )

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    )

  body.bg-light

    .container.mt-4

      h2.mb-4.text-primary
        i.bi.bi-clock-history
        |  Asset History Dashboard

      .row.mb-4
        .col-md-3
          .card.text-bg-primary
            .card-body
              h5 Total Assets
              h2= assets.length

        .col-md-3
          .card.text-bg-success
            .card-body
              h5 Issued
              h2= issues.length

        .col-md-3
          .card.text-bg-warning
            .card-body
              h5 Returned
              h2= returns.length

        .col-md-3
          .card.text-bg-danger
            .card-body
              h5 Scrapped
              h2= scraps.length

      // Assets Table
      .card.mb-4
        .card-header.bg-dark.text-white
          i.bi.bi-box-seam
          |  All Assets

        .card-body
          table.table.table-hover.table-bordered
            thead.table-secondary
              tr
                th #
                th Asset
                th Serial

            tbody
              each asset, index in assets
                tr
                  td= index + 1
                  td= asset.assetName
                  td= asset.serialNumber

      // Issued Table
      .card.mb-4
        .card-header.bg-success.text-white
          i.bi.bi-arrow-right-circle
          |  Issued Assets

        .card-body
          table.table.table-hover.table-bordered
            thead.table-light
              tr
                th #
                th Employee
                th Asset

            tbody
              each issue, index in issues
                tr
                  td= index + 1
                  td= issue.employeeName
                  td= issue.assetName

      // Returned Table
      .card.mb-4
        .card-header.bg-warning
          i.bi.bi-arrow-return-left
          |  Returned Assets

        .card-body
          table.table.table-hover.table-bordered
            thead.table-light
              tr
                th #
                th Employee
                th Asset
                th Reason

            tbody
              each ret, index in returns
                tr
                  td= index + 1
                  td= ret.employeeName
                  td= ret.assetName
                  td= ret.reason

      // Scrapped Table
      .card.mb-4
        .card-header.bg-danger.text-white
          i.bi.bi-trash
          |  Scrapped Assets

        .card-body
          table.table.table-hover.table-bordered
            thead.table-light
              tr
                th #
                th Asset
                th Reason

            tbody
              each scrap, index in scraps
                tr
                  td= index + 1
                  td= scrap.assetName
                  td= scrap.reason