doctype html
html
  head
    title Return Asset
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.bg-light
    .container.mt-4

      h2 Return Asset

      form(method="POST" action="/add-return" class="card p-3")

        input.form-control.mb-2(type="text" name="employeeName" placeholder="Employee Name" required)
        input.form-control.mb-2(type="text" name="assetName" placeholder="Asset Name" required)
        input.form-control.mb-2(type="text" name="reason" placeholder="Reason" required)

        button.btn.btn-success Return Asset

      hr

      table.table.table-bordered
        thead.table-dark
          tr
            th #
            th Employee
            th Asset
            th Reason

        tbody
          each ret, index in returns
            tr
              td= index + 1
              td= ret.employeeName
              td= ret.assetName
              td= ret.reason