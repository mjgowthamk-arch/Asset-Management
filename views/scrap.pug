doctype html
html
  head
    title Scrap Asset
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.bg-light
    .container.mt-4

      h2 Scrap Asset

      form(method="POST" action="/add-scrap" class="card p-3")

        input.form-control.mb-2(type="text" name="assetName" placeholder="Asset Name" required)
        input.form-control.mb-2(type="text" name="reason" placeholder="Reason" required)

        button.btn.btn-danger Scrap Asset

      hr

      table.table.table-bordered
        thead.table-dark
          tr
            th #
            th Asset
            th Reason

        tbody
          each scrap, index in scraps
            tr
              td= index + 1
              td= scrap.assetName
              td= scrap.reason