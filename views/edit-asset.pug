doctype html
html
  head
    title Edit Asset
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.bg-light
    .container.mt-5

      h3 Edit Asset

      form(method="POST" action=`/update-asset/${asset.id}` class="card p-3")

        input.form-control.mb-2(type="text" name="assetName" value=asset.assetName required)
        input.form-control.mb-2(type="text" name="serialNumber" value=asset.serialNumber required)
        input.form-control.mb-2(type="text" name="category" value=asset.category)
        input.form-control.mb-2(type="text" name="model" value=asset.model)
        input.form-control.mb-2(type="number" name="value" value=asset.value)

        button.btn.btn-primary Update