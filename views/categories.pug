doctype html
html
  head
    title Categories
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body.container.mt-5
    h2 Asset Categories

    form(method="POST" action="/add-category")
      input.form-control.mb-3(type="text" name="categoryName" placeholder="Category Name" required)
      button.btn.btn-primary Add Category

    hr

    table.table.table-bordered
      thead
        tr
          th ID
          th Category Name

      tbody
        each category in categories
          tr
            td= category.id
            td= category.categoryName